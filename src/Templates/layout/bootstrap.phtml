        }
        
        /* Dark mode support */
        [data-bs-theme="dark"] .hero-section {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        }
        
        [data-bs-theme="dark"] .card {
            background-color: var(--bs-dark);
            border-color: var(--bs-gray-700);
        }
        
        /* Theme toggle button */
        .theme-toggle {
            position: fixed;
            bottom: 2rem;
